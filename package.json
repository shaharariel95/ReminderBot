{
  "name": "nu-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "db:init": "wrangler d1 execute nu-bot --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute nu-bot --local --file=./schema.sql",
    "test:time": "npx tsx test/time.test.ts",
    "test:parse": "npx tsx test/quickparse.test.ts",
    "test:voice": "npx tsx test/voice.test.ts",
    "test:bot": "npx tsx test/bot.test.ts",
    "test:facts": "npx tsx test/facts.test.ts",
    "test:validate": "npx tsx test/validate.test.ts",
    "test:buttons": "npx tsx test/buttons.test.ts",
    "test:effects": "npx tsx test/effects.test.ts",
    "test:v08": "npx tsx test/v08.test.ts",
    "test:friends": "npx tsx test/friends.test.ts",
    "test:models": "npx tsx test/models.test.ts",
    "test:comprehension": "npx tsx test/comprehension.test.ts",
    "test:patterns": "npx tsx test/patterns.test.ts",
    "test": "npm run test:time && npm run test:parse && npm run test:voice && npm run test:validate && npm run test:buttons && npm run test:bot && npm run test:facts && npm run test:effects && npm run test:v08 && npm run test:friends && npm run test:models && npm run test:comprehension && npm run test:patterns"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^26.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
